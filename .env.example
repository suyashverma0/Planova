# Environment Configuration Example for Planova
# Copy this file to .env before starting services. DO NOT put real secrets here.

# General App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL 16)
POSTGRES_USER=planova
POSTGRES_PASSWORD=planova_dev_secret
POSTGRES_DB=planova_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://planova:planova_dev_secret@localhost:5432/planova_db

# Redis Cache & Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM Provider Configuration (Protocol: LLMClient)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_provider_api_key_here
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=15

# External APIs
YOUTUBE_DATA_API_KEY=your_youtube_api_key_here

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=planova_goal_completion

# Prometheus / Monitoring
PROMETHEUS_PORT=9090
